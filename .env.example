# Copy this file to a new file named ".env" (in this same folder) and paste your real key.
# Get a key at https://platform.openai.com  ->  API keys  ->  Create new secret key
# The .env file is git-ignored so your key stays private.
EXPO_PUBLIC_OPENAI_API_KEY=sk-paste-your-key-here

# Supabase — from your project's Connect / API settings. Safe to be public
# (protected by row-level security), but keep them in this git-ignored file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
