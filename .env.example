# Copy this file to a new file named ".env" (in this same folder) and fill in
# your real values. The .env file is git-ignored so your config stays private.
#
# NOTE: The OpenAI key does NOT go in this file. It lives only on the server as
# a Supabase secret (so it is never inside the app):
#   supabase secrets set OPENAI_API_KEY=sk-... --project-ref <your-project-ref>

# Supabase — from your project's Connect / API settings. Safe to be public
# (protected by row-level security).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# RevenueCat (Trak Pro) — public SDK key for Android, from app.revenuecat.com
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
