# Copy this file to a new file named ".env" (in this same folder) and fill in
# your real values. The .env file is git-ignored so your config stays private.
#
# NOTE: AI keys do NOT go in this file. They live only on the server as
# Supabase secrets (so they are never inside the app):
#   supabase secrets set GEMINI_API_KEY=... --project-ref <your-project-ref>
#   supabase secrets set EXA_API_KEY=...    --project-ref <your-project-ref>   # optional web-search fallback
#   supabase secrets set GEMINI_MODEL=...   --project-ref <your-project-ref>   # optional, defaults to gemini-2.5-flash
#   supabase secrets set REVENUECAT_SECRET_API_KEY=... --project-ref <your-project-ref>
# Optional trusted tester access is configured server-side with TRAK_TESTER_USER_IDS
# (comma-separated Supabase user IDs) or Auth app_metadata.trak_tester=true.

# Supabase — from your project's Connect / API settings. Safe to be public
# (protected by row-level security).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# RevenueCat (Trak Pro) — public SDK keys, from app.revenuecat.com
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# Sentry crash reporting. The DSN is a public client identifier, not a secret.
# Reporting stays disabled in development and whenever this value is empty.
EXPO_PUBLIC_SENTRY_DSN=
# Set false in non-production build profiles even if their EAS environment has a DSN.
EXPO_PUBLIC_SENTRY_ENABLED=true
