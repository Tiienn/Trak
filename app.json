{
  "expo": {
    "name": "Trak",
    "slug": "trak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "trak",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.tien.trak",
      "permissions": [
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.WRITE_NUTRITION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0C1210",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1210",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Trak uses your camera to scan meals and estimate calories."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Trak needs access to your photos so you can pick a meal to scan."
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-connect-delegate.js",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Calorie",
              "label": "Trak calories",
              "description": "Today's calories left at a glance",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "260dp",
              "maxResizeHeight": "180dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
